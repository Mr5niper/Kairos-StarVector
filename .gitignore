# =============================================================================
#  Kairos StarVector - .gitignore
# =============================================================================

# --- PyInstaller output ------------------------------------------------------
#  The .spec is generated by PyInstaller on every run from the flags in
#  BUILD_EXE.bat, and deleted again when the build finishes. Committing one
#  would let it drift out of step with the bat, and whichever the build picked
#  up would silently win over the other.
build/
dist/
*.spec
*.manifest

# --- Virtual environments ----------------------------------------------------
#  BUILD_EXE.bat and START.bat create .\venv. With the pinned stack that is
#  several hundred MB; with the ML extras, several GB.
venv/
.venv/
env/
ENV/
pip-wheel-metadata/

# --- Python ------------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg-info/
.eggs/
.Python

# --- Runtime output ----------------------------------------------------------
#  Note the `dir/*` plus `!dir/.gitkeep` form rather than a bare `dir/`.
#  Git does not descend into an excluded directory, so a bare rule makes the
#  negation unreachable and the empty folder vanishes from a fresh clone.
artifacts/*
!artifacts/.gitkeep

exports/*
!exports/.gitkeep

data/*
!data/.gitkeep

features/*
!features/.gitkeep

# --- Streamlit ---------------------------------------------------------------
.streamlit/secrets.toml
.streamlit/config.toml

# --- Stale ephemeris ---------------------------------------------------------
#  Left over from the Skyfield era. Nothing needs these now that positions
#  come from ephem, and they are 17 MB each.
*.bsp
de[0-9]*.bsp*
deltat.*
Leap_Second.dat

# --- Model caches ------------------------------------------------------------
#  Hugging Face weights pulled by the optional sentiment feature. FinBERT is
#  ~440 MB and must never reach a repo.
.cache/
huggingface/
*.safetensors
*.onnx
*.pt
*.pth
*.ckpt

# --- Notebooks, tests, profiling ---------------------------------------------
.ipynb_checkpoints/
*.prof
.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

# --- Editors -----------------------------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~

# --- OS ----------------------------------------------------------------------
.DS_Store
._*
.Spotlight-V100
.Trashes
Thumbs.db
ehthumbs.db
desktop.ini
$RECYCLE.BIN/

# --- Local overrides ---------------------------------------------------------
#  configs/default.yaml IS tracked. A personal copy next to the exe is not.
configs/local.yaml
configs/*.local.yaml
.env
.env.*
